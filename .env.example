# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never expose these to the browser
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# fixtures = deterministic local AI output (no provider calls). live = real providers.
AI_MODE=fixtures
# test is the only supported mode for the October beta.
PAYMENTS_MODE=test
# Secret for the Vercel cron route that releases expired review windows.
CRON_SECRET=
# Used only by `npm run seed`
SEED_DEMO_PASSWORD=
